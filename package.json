{
  "name": "elaina-node",
  "version": "1.0.0",
  "description": "Lightweight backend framework powered by Node.js",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --quiet src/main.ts",
    "build": "tsc",
    "prod": "node dist/main.js",
    "migration:run": "ts-node src/command/migration.command.ts",
    "seeder:run": "ts-node src/command/seeder.command.ts"
  },
  "engines": {
    "node": ">=18.8.0"
  },
  "author": "layhome12",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "mysql2": "^3.22.1",
    "rimraf": "^5.0.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.13.0",
    "@types/node": "^18.19.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
